{
  "name": "cardano-hw-cli",
  "version": "1.19.1",
  "commit": "97047f09baf7165a8eda1058980f53b38ff7dcbb",
  "description": "Cardano CLI tool for hardware wallets",
  "author": "Vacuumlabs",
  "homepage": "https://github.com/vacuumlabs/cardano-hw-cli#readme",
  "main": "src/index.ts",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vacuumlabs/cardano-hw-cli.git"
  },
  "bugs": {
    "url": "https://github.com/vacuumlabs/cardano-hw-cli/issues"
  },
  "scripts": {
    "build": "./scripts/build-all.sh",
    "build-linux-deb": "./scripts/build-common.sh && ./scripts/build-linux-deb-package.sh",
    "build-linux-tar": "./scripts/build-common.sh && ./scripts/build-linux-x64-tar-gz.sh",
    "build-linux-tar-arm64": "./scripts/build-common.sh && ./scripts/build-linux-arm64-tar-gz.sh",
    "build-windows": "./scripts/build-common.sh && ./scripts/build-windows.sh",
    "build-macos-x64": "./scripts/build-common.sh && ./scripts/build-macos-x64.sh",
    "build-macos-arm64": "./scripts/build-common.sh && ./scripts/build-macos-arm64.sh",
    "build-js": "tsc -p src/tsconfig.json",
    "dev": "yarn build-js && node --no-warnings=ExperimentalWarning dist/index.js",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint src/ test/ --max-warnings=0 --ext .ts,.js",
    "prettier:check": "prettier --check .",
    "prettier": "prettier --write .",
    "spell:check": "yarn cspell lint --gitignore '**' 2>/dev/null",
    "test-unit": "mocha -r ts-node/register 'test/unit/**/*.ts'",
    "test-bin": "yarn build && ./build/linux/archive-x64/cardano-hw-cli/cardano-hw-cli --help",
    "test-integration-ledger": "mocha -r ts-node/register 'test/integration/ledger/node/**/*.ts' --exit",
    "test-integration-ledger-speculos": "LEDGER_TRANSPORT=speculos yarn test-integration-ledger",
    "test-integration-trezor": "mocha -r ts-node/register 'test/integration/trezor/node/**/*.ts' --exit",
    "test-integration-keystone": "mocha -r ts-node/register 'test/integration/keystone/node/**/*.ts' --exit",
    "clean": "rm -rf ./dist && rm -rf ./node_modules",
    "pkg": "pkg",
    "postinstall": "node scripts/fix-trezor-firmware.js"
  },
  "dependencies": {
    "@cardano-foundation/ledgerjs-hw-app-cardano": "7.1.3",
    "@emurgo/cardano-serialization-lib-nodejs": "^13.1.0",
    "@keystonehq/bc-ur-registry": "^0.7.1",
    "@keystonehq/bc-ur-registry-cardano": "^0.5.0",
    "@keystonehq/hw-transport-error": "^0.0.2",
    "@keystonehq/hw-transport-nodeusb": "^0.1.1",
    "@keystonehq/hw-transport-usb": "^0.1.1",
    "@keystonehq/keystone-sdk": "^0.8.1",
    "@ledgerhq/hw-transport": "^6.27.10",
    "@ledgerhq/hw-transport-node-hid-noevents": "^6.24.1",
    "@ngraveio/bc-ur": "^1.1.13",
    "@trezor/connect": "^9.6.3",
    "argparse": "^2.0.1",
    "bech32": "^2.0.0",
    "bignumber": "^1.1.0",
    "cardano-crypto.js": "^6.1.2",
    "cardano-hw-interop-lib": "^3.0.2",
    "cbor": "^8.1.0",
    "lodash": "^4.17.23",
    "rw": "1.3.3",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@ledgerhq/hw-transport-node-speculos": "^6.27.10",
    "@types/argparse": "^2.0.10",
    "@types/lodash": "^4.17.20",
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "@yao-pkg/pkg": "^6.1.0",
    "cspell": "^9.2.1",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-config-vacuumlabs": "^8.0.2",
    "eslint-plugin-import": "^2.25.4",
    "eslint-plugin-mocha": "^10.1.0",
    "eslint-plugin-simple-import-sort": "^7.0.0",
    "mocha": "^11.7.2",
    "prettier": "^2.6.2",
    "ts-node": "^10.9.1",
    "typescript": "^4.9.4"
  },
  "pkg": {
    "assets": [
      "package.json",
      "node_modules/usb/prebuilds/**/*"
    ]
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=6.x",
    "yarn": "^4.13.0"
  },
  "resolutions": {
    "node-abi": "^3.24.0",
    "usb": "^2.11.0",
    "pbkdf2": "^3.1.3",
    "cipher-base": "^1.0.6",
    "sha.js": "^2.4.12",
    "tar-fs": "^2.1.3",
    "minimatch": "^9.0.7",
    "serialize-javascript": "^7.0.3",
    "jws": "^4.0.1",
    "axios": "^1.13.5",
    "lodash": "^4.17.23",
    "js-yaml": "^4.1.1",
    "ajv": "^6.14.0",
    "bn.js": "^5.2.3",
    "undici": "^7.18.2",
    "diff": "^8.0.3",
    "glob": "^10.5.0"
  },
  "packageManager": "yarn@4.13.0"
}
